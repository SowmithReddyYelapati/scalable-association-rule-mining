{
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/**,webapp/**,static/**,data/**}"
    }
  },
  "env": {
    "PYTHONPATH": "."
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
