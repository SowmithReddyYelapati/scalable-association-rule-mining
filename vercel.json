{
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/**,webapp/**,static/**,data/**}"
    }
  },
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
